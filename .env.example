# Telegram bot token from @BotFather (required)
BOT_TOKEN=

# debug | info | warn | error (default: info)
LOG_LEVEL=info

# text | json (default: text)
LOG_FORMAT=text

# Path to yt-dlp, used for YouTube (default: yt-dlp from PATH). YouTube is
# disabled if yt-dlp or ffmpeg can't be found.
YTDLP_PATH=yt-dlp

# Servers (VPS, cloud) are often blocked by YouTube ("Sign in to confirm you're
# not a bot") and TikTok. Two ways around it, usable together:
#
# 1) Cookies: a cookies.txt (Netscape format) exported from a logged-in browser,
#    used for every site yt-dlp handles; it may hold cookies for several sites.
#    Export from a private window with a throwaway account, never your main one.
#    In Docker, mount the file: -v ./cookies.txt:/cookies.txt:ro and set
#    YTDLP_COOKIES=/cookies.txt. The bot works on a private copy for every run.
YTDLP_COOKIES=
#    Or, where mounting a file is awkward (Coolify compose apps), put the file's
#    contents in YTDLP_COOKIES_B64, base64-encoded (use one form, not both):
#      Linux/macOS:  base64 -w0 cookies.txt
#      PowerShell:   [Convert]::ToBase64String([IO.File]::ReadAllBytes("cookies.txt"))
#    INSTAGRAM_COOKIES_B64 and REDDIT_COOKIES_B64 work the same way.
YTDLP_COOKIES_B64=
#
# 2) Proxy: route yt-dlp through a proxy whose IP is not blocked, e.g.
#    http://user:pass@host:3128 or socks5://host:1080 (residential proxies work best).
YTDLP_PROXY=

# Local Telegram Bot API server (https://github.com/tdlib/telegram-bot-api), e.g.
# http://telegram-bot-api:8081 as in docker-compose.yml. Uploads then only go to
# that server, which sends them on to Telegram itself. Before the first start
# with it, log the bot out of api.telegram.org once with "bot logout-cloud".
# Empty: the bot talks to api.telegram.org.
TELEGRAM_API_URL=
# With a local Bot API server: a folder both containers mount at the same path
# (docker-compose.yml: the "media" volume at /media). Downloads stay there and
# the server reads them itself, which allows files up to 300 MB (videos over
# that are compressed to fit). Empty: files are uploaded from memory, up to 50 MB.
MEDIA_DIR=
# The local server's credentials, from https://my.telegram.org ("API
# development tools"). Read by the telegram-bot-api container, not the bot.
# Keep them secret: they identify your app to Telegram.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Proxy for all Telegram Bot API traffic: receiving messages, and sending and
# uploading the videos/music. Same format as YTDLP_PROXY (no socks4). Set it if
# the logs show getUpdates failing again and again with "502 Bad Gateway".
# docker-compose.yml points it at the WARP container by default.
TELEGRAM_PROXY=

# URL of a bgutil PO token server (https://github.com/Brainicism/bgutil-ytdlp-pot-provider).
# Even with cookies, YouTube can withhold the streams from servers ("Requested
# format is not available") unless yt-dlp shows a PO token. docker-compose.yml
# runs the server as the "pot" service and points this at http://pot:4416.
YTDLP_POT_URL=

# Proxy for YouTube (and Spotify, which is fetched from YouTube) instead of
# YTDLP_PROXY: "direct" for no proxy, or a proxy URL. Empty: YTDLP_PROXY.
# docker-compose.yml sets "direct": with cookies and a PO token YouTube works
# from the server's own address, and skipping the proxy is faster.
YOUTUBE_PROXY=

# Optional per-site cookies.txt, used instead of YTDLP_COOKIES for that site.
# Instagram needs them only for posts that refuse anonymous access.
INSTAGRAM_COOKIES=

# Reddit only works with a logged-in cookies.txt (same format as above); Reddit
# support stays disabled while this is empty. Use a throwaway account: the
# cookies give the bot access to that account.
REDDIT_COOKIES=

# Chat id the bot uploads videos to so it can send them in inline mode for
# sites without direct video URLs (YouTube). Use your own private chat with the
# bot (send it /start first) or a private channel where the bot is admin.
# Also enable inline feedback: BotFather -> /setinlinefeedback -> Enabled (100%).
STORAGE_CHAT_ID=

# Concurrent downloads allowed per user and across the whole bot (defaults 5 and
# 100). Each running download holds up to 50 MB in memory, so size the total to
# your server's RAM.
MAX_USER_DOWNLOADS=5
MAX_TOTAL_DOWNLOADS=100
